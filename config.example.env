# ============================================================================
#  config.example.env  ·  copia a .env (local) o ponlo como Secrets del repo
#  cp config.example.env .env  &&  set -a && source .env && set +a
# ============================================================================

# ---------- Supabase (OBLIGATORIO) ----------
# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Project Settings > API > service_role  (¡NUNCA la expongas en el navegador!)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....
# Project Settings > Database > Connection string (URI)  -> solo para aplicar el SQL
SUPABASE_DB_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------- APIs de metadatos ----------
# TMDB (gratis): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# OMDb (gratis, 1000/día): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# AniList / Kitsu / Jikan(MAL) NO necesitan clave

# ---------- Comportamiento ----------
BATCH_SIZE=400            # filas por ronda
ENRICH_ROUNDS=25          # rondas por corrida (cada una pide BATCH_SIZE filas)
WORKERS=8                 # hilos en paralelo
RECHECK_DAYS=45           # reintentar filas ya chequeadas (0 = todas)
FILL_ALL_IDS=true         # exigir todos los IDs por tipo
ONLY_TYPES=               # ej: movie,series  (vacío = todos)
DRY_RUN=false

# ---------- Limpieza ----------
PURGE_JUNK=true
PURGE_BLOCKED=true        # xxx / onlyfans / porn / hentai / jav / ...
PURGE_SOFT_ADULT=false    # agresivo extra: nude, erotic, playboy, webcam...
# Filas SIN nombre (title y title_text vacíos): por defecto NO se borran.
# Pon true solo si de verdad no quieres recuperarlas (es irreversible).
PURGE_EMPTY_TITLE=false
PURGE_ABSOLUTE_ONLY=true  # borra series/anime con episodio SOLO en absolute_episode
ABSOLUTE_ONLY_ACTION=delete   # delete | nullify
ABSOLUTE_REQUIRE_SEASON_NULL=true  # true = solo borra si tampoco hay temporada
PURGE_DEAD=false          # borra 0 seeders y viejo
DEAD_MIN_SEEDERS=1
DEAD_OLDER_DAYS=60
# La limpieza va por TANDAS de ids: la API de Supabase mata cualquier
# statement de más de ~8 s (error 57014) y la purga adulta se pasaba de
# largo en tablas grandes. Cada tanda es un rango corto de la primary key,
# así que usa el índice y cabe de sobra. Si una tanda se pasa del timeout
# se ENCOGE sola y se reintenta.
PURGE_CHUNK_ROWS=20000    # filas por tanda (0 = tabla entera de una vez: no recomendado)
PURGE_CHUNK_MIN=1000      # suelo al encoger la tanda por timeout

# ---------- Mejores torrents (regla simple) ----------
KEEP_BEST=false           # la regla de español de abajo ya hace el top-N
KEEP_BEST_LIMIT=3         # conserva los N mejores por obra/temporada/episodio
KEEP_BEST_MIN_SEEDERS=0
KEEP_BEST_ONLY_TYPES=     # ej: series,anime

# ---------- SELECTOR: cuántas filas editar/borrar en ESTA corrida ----------
MAX_DELETES_PER_RUN=0              # 0 = sin tope. Ej.: 500 = como mucho 500 filas EN TOTAL por corrida

# ---------- Reordenador de la columna id ----------
RENUMBER_IDS=true                  # deja la columna id en 1..N después de borrar
RENUMBER_IDS_FORCE=false           # true = renumerar aunque haya FK hacia torrents(id)
RENUMBER_MAX_ROWS=200000           # tope de seguridad: no reescribe tablas gigantes

# ---------- Regla de español: dedupe + top 3 + mínimo 2 en español ----------
KEEP_BEST_ES=true
KEEP_BEST_ES_LIMIT=3               # máximo de torrents por película/episodio
KEEP_BEST_ES_MIN_SPANISH=2         # cuántos con español garantizar (audio o subs)
KEEP_BEST_ES_ALLOW_SUBS_FALLBACK=true # CASCADA: si no hay audio en español, valen los subtítulos en español
KEEP_BEST_ES_DEDUPE=true           # borra repetidos (misma calidad+códec+HDR+tamaño+grupo)
KEEP_BEST_ES_STRICT=false          # true = borra el grupo completo si no hay 2 en español
KEEP_BEST_ES_USE_TITLE_HINT=true   # también cuenta si el título dice "latino/castellano/español"
SPANISH_TOKENS_EXTRA=              # tokens propios, ej: es-la,espanol neutro,audio latino
SPANISH_REPORT_LIMIT=15            # cuántos grupos sin español listar en el reporte

# ---------- Reintentos de IDs que quedaron NULL ----------
RETRY_MISSING=true                 # vuelve a la cola los que no obtuvieron ningún ID
RETRY_MAX_ATTEMPTS=4               # intentos máximos por fila (evita bucle infinito)
RETRY_MIN_AGE_MINUTES=60           # no reintentar antes de N minutos
RETRY_ROUNDS=10                    # rondas por corrida en modo reintento
AGGRESSIVE_FALLBACK=true           # usa title_text + IMDb suggestions + TVmaze (sin clave)

# ---------- Listas propias (separadas por coma) ----------
BLOCKED_TOKENS_EXTRA=     # ej: mi-marca-rara,otro-token
ALLOW_TOKENS_EXTRA=       # excepciones: ej: sex and the city,adult swim
